# ═══════════════════════════════════════════════════════════════
# Configuration pour Railway.app
# ═══════════════════════════════════════════════════════════════

# JWT Secret - Génère un secret long et aléatoire
# Sur PowerShell, génère un secret avec :
# -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
JWT_SECRET=change_moi_avec_un_secret_long_et_securise_123456789

# Discord Bot Token
# Obtiens-le sur : https://discord.com/developers/applications
# Ton bot > Bot > Token (Reset Token si besoin)
DISCORD_TOKEN=ton_token_discord_ici

# Environment (ne change pas)
NODE_ENV=production
